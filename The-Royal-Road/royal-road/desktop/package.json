{
  "name": "the-royal-road",
  "productName": "The Royal Road",
  "version": "1.1.0",
  "description": "A dream engine that looks like an oscilloscope.",
  "author": "The Royal Road",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.royalroad.engine",
    "productName": "The Royal Road",
    "files": ["main.js", "preload.js", "ui/**/*", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "The-Royal-Road-Setup.exe",
      "shortcutName": "The Royal Road",
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    },
    "portable": { "artifactName": "The-Royal-Road-Portable.exe" }
  }
}
